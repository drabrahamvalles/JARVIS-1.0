# Copia este archivo a .env y configura tus dos secretos.
OPENAI_API_KEY=
JARVIS_TOKEN=
# Solo este Mac. En Cloud Run se usa HOST=0.0.0.0.
HOST=127.0.0.1
# Puerto local opcional; Cloud Run proporciona PORT automáticamente.
PORT=8000
# Identificador local asignado por el servidor para separar la memoria de cada usuario.
JARVIS_USER_ID=principal
# Calendarios de Google compartidos con la cuenta de servicio, separados por comas.
# En Cloud Run viene del secreto JARVIS_CALENDARIOS. Vacío = agenda desconectada.
JARVIS_CALENDARIOS=
