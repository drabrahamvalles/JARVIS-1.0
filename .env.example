# Copia este archivo a .env y configura tus dos secretos.
OPENAI_API_KEY=
JARVIS_TOKEN=
# Solo este Mac. En Railway/Render omite HOST o usa 0.0.0.0.
HOST=127.0.0.1
# Puerto local opcional; Railway/Render proporciona PORT automáticamente.
PORT=8000
# Identificador local asignado por el servidor para separar la memoria de cada usuario.
JARVIS_USER_ID=principal
